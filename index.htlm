Le fichier que je peux te fournir sera généré localement en `index.html`, pas directement créé sur GitHub. Il suffit de l’ajouter manuellement dans ton dépôt.

```html name=index.html url=https://github.com/micheltshiepela331-gif/Mica-Code/blob/main/index.htm
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Mica Code</title>
  <style>
    :root{
      color-scheme:dark;
      --bg:#0d1117;
      --panel:#161b22;
      --header:#010409;
      --border:#30363d;
      --text:#e6edf3;
      --muted:#8b949e;
      --accent:#2f81f7;
      --editor-size:14px;
    }
    *{box-sizing:border-box}
    html,body{
      width:100%;
      height:100%;
      margin:0;
      overflow:hidden;
    }
    body{
      display:flex;
      flex-direction:column;
      background:var(--bg);
      color:var(--text);
      font:14px/1.45 system-ui,sans-serif;
      padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
    }
    button,input,textarea{font:inherit}
    button{
      min-height:36px;
      padding:6px 11px;
      border:1px solid var(--border);
      border-radius:6px;
      color:var(--text);
      background:var(--panel);
      cursor:pointer;
      white-space:nowrap;
    }
    button:hover{background:#242c36}
    button[aria-pressed="true"]{
      background:var(--accent);
      border-color:var(--accent);
      color:white;
    }
    button:focus-visible,input:focus-visible,textarea:focus-visible{
      outline:2px solid var(--accent);
      outline-offset:2px;
    }
    #top{
      display:flex;
      align-items:center;
      gap:8px;
      flex:none;
      padding:8px 12px;
      background:var(--header);
      border-bottom:1px solid var(--border);
    }
    #brand{font-weight:700;white-space:nowrap}
    #filename{
      width:min(220px,32vw);
      min-width:100px;
      padding:7px 9px;
      border:1px solid var(--border);
      border-radius:6px;
      background:var(--bg);
      color:var(--text);
    }
    #status{
      margin-left:auto;
      color:#7ee787;
      font-size:12px;
    }
    #toolbar{
      display:flex;
      align-items:center;
      gap:6px;
      flex:none;
      overflow-x:auto;
      padding:7px 10px;
      background:var(--panel);
      border-bottom:1px solid var(--border);
    }
    #workspace{
      display:flex;
      flex:1;
      min-width:0;
      min-height:0;
      overflow:hidden;
    }
    #editorPane,#previewPane{
      display:flex;
      flex-direction:column;
      flex:1 1 50%;
      min-width:0;
      min-height:0;
      overflow:hidden;
    }
    .paneHead{
      display:flex;
      align-items:center;
      gap:8px;
      flex:none;
      min-height:36px;
      padding:5px 10px;
      background:var(--panel);
      border-bottom:1px solid var(--border);
      color:var(--muted);
      font-size:12px;
    }
    .paneHead strong{color:var(--text)}
    #editor{
      flex:1;
      width:100%;
      min-width:0;
      min-height:0;
      resize:none;
      overflow:auto;
      padding:14px;
      border:0;
      outline:0;
      background:var(--bg);
      color:var(--text);
      font:var(--editor-size)/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;
      tab-size:2;
      white-space:pre;
      overflow-wrap:normal;
      overscroll-behavior:contain;
    }
    #preview{
      flex:1;
      width:100%;
      height:100%;
      border:0;
      background:white;
    }
    #divider{
      flex:0 0 6px;
      background:var(--border);
      cursor:col-resize;
      touch-action:none;
    }
    #divider:hover{background:var(--accent)}
    #statusbar{
      display:flex;
      gap:16px;
      flex:none;
      padding:4px 10px;
      background:var(--accent);
      color:white;
      font-size:12px;
    }
    #lineInfo{margin-right:auto}
    body.editor-only #previewPane,
    body.editor-only #divider,
    body.preview-only #editorPane,
    body.preview-only #divider{display:none}
    body.editor-only #editorPane,
    body.preview-only #previewPane{flex:1 1 100%}
    body.fullscreen #top,
    body.fullscreen #toolbar,
    body.fullscreen #statusbar{display:none}

    @media(max-width:760px){
      #workspace{flex-direction:column}
      #editorPane,#previewPane{
        flex:1 1 50%;
        width:100%;
      }
      #divider{
        flex:0 0 6px;
        cursor:row-resize;
      }
      #top{padding:6px 8px}
      #toolbar{padding:5px 8px}
      #statusbar{gap:9px;font-size:11px}
    }

    @media(min-width:1200px){
      #editorPane{flex-basis:68%}
      #previewPane{flex-basis:32%}
    }
  </style>
</head>
<body>
  <header id="top">
    <span id="brand">◐ Mica Code</span>
    <input id="filename" aria-label="Nom du fichier" value="index.html">
    <span id="status" role="status" aria-live="polite">Prêt</span>
  </header>

  <nav id="toolbar" aria-label="Outils de l’éditeur">
    <button id="pcMode" type="button" aria-pressed="false">🖥 Mode PC</button>
    <button id="showCode" type="button" aria-pressed="true">‹› Code</button>
    <button id="showPreview" type="button" aria-pressed="true">▣ Aperçu</button>
    <button id="run" type="button">▶ Exécuter</button>
    <button id="undo" type="button">↶ Annuler</button>
    <button id="redo" type="button">↷ Rétablir</button>
    <button id="fontDown" type="button">A−</button>
    <button id="fontUp" type="button">A+</button>
    <button id="download" type="button">⬇ Télécharger</button>
    <button id="fullscreen" type="button">⛶ Plein écran</button>
  </nav>

  <main id="workspace">
    <section id="editorPane" aria-label="Éditeur de code">
      <div class="paneHead">
        <strong id="fileLabel">index.html</strong>
        <span id="stats">0 lignes · 0 caractères</span>
      </div>
      <textarea id="editor" aria-label="Code HTML" spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" wrap="off"></textarea>
    </section>

    <div id="divider" role="separator" aria-label="Séparateur" aria-orientation="vertical" tabindex="0"></div>

    <section id="previewPane" aria-label="Aperçu">
      <div class="paneHead">
        <strong>Aperçu en direct</strong>
      </div>
      <iframe id="preview" title="Aperçu du projet" sandbox="allow-scripts allow-forms allow-modals"></iframe>
    </section>
  </main>

  <footer id="statusbar">
    <span id="lineInfo">Ln 1, Col 1</span>
    <span>UTF-8</span>
    <span>HTML</span>
  </footer>

<script>
(function () {
  "use strict";

  function $(id) {
    return document.getElementById(id);
  }

  var editor = $("editor");
  var preview = $("preview");
  var status = $("status");
  var workspace = $("workspace");

  var starter = `<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mon premier site</title>
  <style>
    body {
      max-width: 760px;
      margin: 60px auto;
      padding: 0 20px;
      font-family: system-ui, sans-serif;
    }
  </style>
</head>
<body>
  <h1>Bonjour Michel !</h1>
  <p>Modifie ce code : l’aperçu se met à jour automatiquement.</p>
  <button onclick="document.querySelector('p').textContent='Ça fonctionne !'">
    Clique ici
  </button>
</body>
</html>`;

  var statusTimer;
  var previewTimer;
  var history = [""];
  var historyIndex = 0;

  function safeGet(key) {
    try {
      return localStorage.getItem(key);
    } catch (error) {
      return null;
    }
  }

  function safeSet(key, value) {
    try {
      localStorage.setItem(key, value);
      return true;
    } catch (error) {
      return false;
    }
  }

  function notify(message) {
    status.textContent = message;
    clearTimeout(statusTimer);
    statusTimer = setTimeout(function () {
      status.textContent = "Prêt";
    }, 2200);
  }

  function updateStats() {
    var text = editor.value;
    $("stats").textContent =
      text.split("\n").length + " lignes · " + text.length + " caractères";

    var before = text.slice(0, editor.selectionStart).split("\n");
    $("lineInfo").textContent =
      "Ln " + before.length + ", Col " + (before[before.length - 1].length + 1);
  }

  function persist() {
    safeSet("mica_code_content", editor.value);
    safeSet("mica_code_filename", $("filename").value || "index.html");
  }

  function updatePreview() {
    preview.srcdoc = editor.value;
    persist();
  }

  function addHistory() {
    var value = editor.value;

    if (history[historyIndex] !== value) {
      history = history.slice(0, historyIndex + 1);
      history.push(value);

      if (history.length > 100) {
        history.shift();
      }

      historyIndex = history.length - 1;
    }
  }

  function schedulePreview() {
    updateStats();
    clearTimeout(previewTimer);
    previewTimer = setTimeout(updatePreview, 350);
  }

  var savedContent = safeGet("mica_code_content");
  var savedFilename = safeGet("mica_code_filename");

  editor.value = savedContent === null ? starter : savedContent;

  if (savedFilename) {
    $("filename").value = savedFilename;
  }

  $("fileLabel").textContent = $("filename").value;
  history = [editor.value];
  updateStats();
  updatePreview();

  function setPcMode(enabled) {
    document.body.classList.toggle("pc-mode", enabled);
    $("pcMode").setAttribute("aria-pressed", String(enabled));
    $("pcMode").textContent =
      enabled ? "📱 Mode téléphone" : "🖥 Mode PC";

    safeSet("mica_pc_mode", String(enabled));
    workspace.style.flexDirection = enabled ? "row" : "column";
    $("divider").style.cursor = enabled ? "col-resize" : "row-resize";
  }

  var pcMode = safeGet("mica_pc_mode");

  if (pcMode === null) {
    pcMode = String(window.matchMedia("(min-width:900px)").matches);
  }

  setPcMode(pcMode === "true");

  $("pcMode").addEventListener("click", function () {
    setPcMode(!document.body.classList.contains("pc-mode"));
  });

  $("run").addEventListener("click", function () {
    updatePreview();
    notify("Aperçu actualisé");
  });

  editor.addEventListener("input", function () {
    schedulePreview();
  });

  ["keyup", "click", "select"].forEach(function (eventName) {
    editor.addEventListener(eventName, updateStats);
  });

  $("filename").addEventListener("input", function () {
    $("fileLabel").textContent = this.value || "index.html";
    persist();
  });

  $("showCode").addEventListener("click", function () {
    document.body.classList.toggle("editor-only");
    document.body.classList.remove("preview-only");
  });

  $("showPreview").addEventListener("click", function () {
    document.body.classList.toggle("preview-only");
    document.body.classList.remove("editor-only");
  });

  $("fontDown").addEventListener("click", function () {
    var size = parseInt(
      getComputedStyle(document.documentElement).getPropertyValue("--editor-size"),
      10
    ) || 14;

    document.documentElement.style.setProperty(
      "--editor-size",
      Math.max(9, size - 1) + "px"
    );
  });

  $("fontUp").addEventListener("click", function () {
    var size = parseInt(
      getComputedStyle(document.documentElement).getPropertyValue("--editor-size"),
      10
    ) || 14;

    document.documentElement.style.setProperty(
      "--editor-size",
      Math.min(30, size + 1) + "px"
    );
  });

  $("download").addEventListener("click", function () {
    var blob = new Blob([editor.value], {
      type: "text/html;charset=utf-8"
    });

    var url = URL.createObjectURL(blob);
    var link = document.createElement("a");

    link.href = url;
    link.download = $("filename").value.trim() || "index.html";

    document.body.appendChild(link);
    link.click();
    link.remove();

    setTimeout(function () {
      URL.revokeObjectURL(url);
    }, 1000);

    notify("Fichier téléchargé");
  });

  $("fullscreen").addEventListener("click", function () {
    document.body.classList.toggle("fullscreen");
  });

  $("undo").addEventListener("click", function () {
    addHistory();

    if (historyIndex > 0) {
      historyIndex--;
      editor.value = history[historyIndex];
      schedulePreview();
      notify("Annulation");
    }
  });

  $("redo").addEventListener("click", function () {
    if (historyIndex < history.length - 1) {
      historyIndex++;
      editor.value = history[historyIndex];
      schedulePreview();
      notify("Rétablissement");
    }
  });

  editor.addEventListener("keydown", function (event) {
    if (event.key === "Tab") {
      event.preventDefault();
      var start = editor.selectionStart;
      var end = editor.selectionEnd;
      editor.setRangeText("  ", start, end, "end");
      schedulePreview();
    }

    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "s") {
      event.preventDefault();
      persist();
      notify("Projet sauvegardé");
    }
  });

  window.addEventListener("beforeunload", persist);
})();
</script>
</body>
</html>
```

Copie ce fichier dans un nouveau document, puis enregistre-le sous le nom exact **`index.html`** avant de le télécharger ou de le mettre sur GitHub.
